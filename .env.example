# Insecure localhost development example. Replace every provider, origin,
# callback, voice credential, and network value before exposing Lag.
ALLOWED_HOSTS=http://localhost:3000
LAG_BIND_ADDRESS=127.0.0.1
AUTH_PROVIDER=oauth2
AUTH_PROVIDER_LABEL=Development OAuth
AUTH_CLIENT_ID=insecure-development-client
AUTH_CLIENT_SECRET=insecure-development-secret
AUTH_SCOPES=profile email
AUTH_PKCE=required
OAUTH_AUTHORIZATION_ENDPOINT=https://provider.example.invalid/oauth/authorize
OAUTH_TOKEN_ENDPOINT=https://provider.example.invalid/oauth/token
OAUTH_USERINFO_ENDPOINT=https://provider.example.invalid/api/user
OAUTH_SUBJECT_PATH=id
OAUTH_NAME_PATH=name
OAUTH_EMAIL_PATH=email
OAUTH_AVATAR_PATH=avatar_url

# Guest access makes this example usable without the deliberately invalid
# OAuth endpoints. Disable it for deployments that require external identity.
GUEST_ENABLED=true
SESSION_IDLE_SECONDS=604800
SESSION_ABSOLUTE_SECONDS=2592000
OAUTH_TRANSACTION_SECONDS=600

# PROXY_HEADER is intentionally unset. Only set a lowercase client-IP header
# when a trusted edge strips client values and supplies its own.
# PROXY_HEADER=x-forwarded-for

# Optional administrator claim mapping.
# AUTH_ADMIN_CLAIM_PATH=roles
# AUTH_ADMIN_CLAIM_VALUE=lag-admin

# For AUTH_PROVIDER=oidc, set OIDC_ISSUER and replace the common credentials.
# OIDC_ISSUER=https://id.example.com

# For AUTH_PROVIDER=prism, set PRISM_ISSUER and use these claim mappings.
# PRISM_ISSUER=https://prism.example.com
PRISM_TEAM_CLAIM_PATH=teams
PRISM_TEAM_ID_PATH=id
PRISM_TEAM_ROLE_PATH=role
PRISM_OWNER_ROLES=owner,co-owner
# PRISM_TEAM_ID=<TEAM_ID>

EXTERNAL_IP=127.0.0.1
VOICE_URL=ws://localhost:7880
LAG_VOICE_KEY=devkey
LAG_VOICE_SECRET=secret

# Optional override for the published fork image.
LAG_IMAGE=ghcr.io/wyf9/lag-server:latest
